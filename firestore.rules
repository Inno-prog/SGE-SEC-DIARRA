rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Permettre à tout utilisateur connecté de lire/écrire son profil
    match /users/{userId} {
      allow read, write: if request.auth != null;
    }
    
    // Pour le reste, autoriser les users connectés (dev uniquement)
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}