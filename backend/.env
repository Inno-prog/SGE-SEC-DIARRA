# Database
DATABASE_URL="postgresql://inno:inno@localhost:5432/sge_secdiarra?schema=public"

# Server
PORT=3000
NODE_ENV=development
API_PREFIX=/api/v1

# JWT
JWT_SECRET=sge-secdiarra-super-secret-jwt-key-2024-min-32-chars-long
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=sge-secdiarra-refresh-token-secret-2024-min-32-chars-long
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080,http://localhost:4200,http://127.0.0.1:4200

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# Email (optional - for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=SGE Secdiarra <noreply@secdiarra.com>

# Frontend URL (for email links)
FRONTEND_URL=http://localhost:5173